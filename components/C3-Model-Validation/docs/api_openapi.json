            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Profiles",
        "tags": [
          "configuration"
        ]
      }
    },
    "/v1/validations": {
      "get": {
        "operationId": "list_runs_v1_validations_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Runs",
        "tags": [
          "validation"
        ]
      },
      "post": {
        "description": "Validate one candidate and return the recommendation. Synchronous: it can take a minute.",
        "operationId": "create_validation_v1_validations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "wrong API key"
          },
          "422": {
            "description": "bad path, profile or body"
          },
          "503": {
            "description": "another validation kept the gate busy"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create Validation",
        "tags": [
          "validation"
        ]
      }
    },
    "/v1/validations/{run_id}": {
      "get": {
        "description": "The full, auditable result: every check, the scorecard, the rules and the configuration used.",
        "operationId": "get_result_v1_validations__run_id__get",
        "parameters": [
          {
            "description": "the run_id returned by POST /v1/validations",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "description": "the run_id returned by POST /v1/validations",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Result",
        "tags": [
          "validation"
        ]
      }
    },
    "/v1/validations/{run_id}/report": {
      "get": {
        "description": "The unified Markdown report.",
        "operationId": "get_report_v1_validations__run_id__report_get",
