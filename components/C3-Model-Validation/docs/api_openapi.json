{
  "components": {
    "schemas": {
      "ActionMode": {
        "enum": [
          "RECOMMENDATION"
        ],
        "title": "ActionMode",
        "type": "string"
      },
      "CandidateSummary": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "eval_data_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eval Data Sha256"
          },
          "metadata_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata Sha256"
          },
          "model_path": {
            "title": "Model Path",
            "type": "string"
          },
          "model_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Sha256"
          }
        },
        "required": [
          "model_path"
        ],
        "title": "CandidateSummary",
        "type": "object"
      },
      "CheckContribution": {
        "additionalProperties": false,
        "description": "How one check fed into its dimension score.\n\n`points` are the check's share of the dimension score, so the points of a\ndimension add up to that dimension's score.",
        "properties": {
          "check_id": {
            "title": "Check Id",
            "type": "string"
          },
          "points": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Points",
            "type": "number"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "treatment": {
            "$ref": "#/components/schemas/CheckTreatment"
          },
          "weight": {
            "exclusiveMinimum": 0.0,
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "check_id",
          "weight",
          "status",
          "treatment",
          "points"
        ],
        "title": "CheckContribution",
        "type": "object"
      },
      "CheckInfo": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "dimension": {
            "title": "Dimension",
            "type": "string"
          },
          "direction": {
            "title": "Direction",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "id",
          "dimension",
          "direction",
          "unit",
          "description"
        ],
        "title": "CheckInfo",
        "type": "object"
      },
      "CheckResult": {
        "additionalProperties": false,
        "description": "Outcome of one validation check.\n\nInvariants (enforced below):\n* PASS/WARN/FAIL have a 0-100 score and real evidence.\n* UNAVAILABLE/NOT_APPLICABLE/ERROR have no score and no evidence, so a\n  check that could not run can never be mistaken for a pass.",
        "properties": {
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "dimension": {
            "$ref": "#/components/schemas/Dimension"
          },
          "direction": {
            "anyOf": [
              {
                "enum": [
                  "higher_is_better",
                  "lower_is_better",
                  "binary"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Direction"
          },
          "evidence_source": {
            "$ref": "#/components/schemas/EvidenceSource"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
            "title": "Id",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "raw_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Value"
          },
          "required": {
            "default": false,
            "title": "Required",
            "type": "boolean"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "thresholds": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Thresholds",
            "type": "object"
          }
        },
        "required": [
          "id",
          "dimension",
          "name",
          "status",
          "evidence_source",
          "message"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "PASS",
          "WARN",
          "FAIL",
          "UNAVAILABLE",
          "NOT_APPLICABLE",
          "ERROR"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "CheckTreatment": {
        "enum": [
          "counted",
          "excluded_unavailable",
          "penalized_as_zero",
          "not_applicable"
        ],
        "title": "CheckTreatment",
        "type": "string"
      },
      "Decision": {
        "enum": [
          "PROMOTE",
          "HOLD",
          "ROLLBACK"
        ],
        "title": "Decision",
        "type": "string"
      },
      "DecisionRecord": {
        "additionalProperties": false,
        "properties": {
          "action_mode": {
            "$ref": "#/components/schemas/ActionMode",
            "default": "RECOMMENDATION"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "mqs": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mqs"
          },
          "overridden_by_critical": {
            "default": false,
            "title": "Overridden By Critical",
            "type": "boolean"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "triggered_rules": {
            "items": {
              "$ref": "#/components/schemas/TriggeredRule"
            },
            "title": "Triggered Rules",
            "type": "array"
          }
        },
        "required": [
          "decision",
          "summary"
        ],
        "title": "DecisionRecord",
        "type": "object"
      },
      "Dimension": {
        "enum": [
          "training_validity",
          "model_behaviour",
          "operational_readiness"
        ],
        "title": "Dimension",
        "type": "string"
      },
      "DimensionScore": {
        "additionalProperties": false,
        "properties": {
          "available_checks": {
            "minimum": 0.0,
            "title": "Available Checks",
            "type": "integer"
          },
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/CheckContribution"
            },
            "title": "Contributions",
            "type": "array"
          },
          "coverage": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage",
            "type": "number"
          },
          "dimension": {
            "$ref": "#/components/schemas/Dimension"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "provisional": {
            "title": "Provisional",
            "type": "boolean"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "total_checks": {
            "minimum": 0.0,
            "title": "Total Checks",
            "type": "integer"
          }
        },
        "required": [
          "dimension",
          "coverage",
          "provisional",
          "available_checks",
          "total_checks"
        ],
        "title": "DimensionScore",
        "type": "object"
      },
      "EvidenceSource": {
        "enum": [
          "MEASURED",
          "DECLARED",
          "SIMULATED",
          "UNAVAILABLE"
        ],
        "title": "EvidenceSource",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "authentication": {
            "title": "Authentication",
            "type": "string"
          },
          "gate_version": {
            "title": "Gate Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "gate_version",
          "authentication"
        ],
        "title": "Health",
        "type": "object"
      },
      "MissingPolicy": {
        "enum": [
          "exclude_and_cap",
          "penalize"
        ],
        "title": "MissingPolicy",
        "type": "string"
      },
      "ProfileInfo": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "description": "whether this server will run the profile",
            "title": "Allowed",
            "type": "boolean"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "enabled_checks": {
            "title": "Enabled Checks",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scans_model_files": {
            "description": "whether the model file is scanned before it is loaded",
            "title": "Scans Model Files",
            "type": "boolean"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Weights",
            "type": "object"
          }
        },
        "required": [
          "name",
          "description",
          "enabled_checks",
          "scans_model_files",
          "allowed",
          "weights"
        ],
        "title": "ProfileInfo",
        "type": "object"
      },
      "ProfileList": {
        "additionalProperties": false,
        "properties": {
          "default_profile": {
            "title": "Default Profile",
            "type": "string"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ProfileInfo"
            },
            "title": "Profiles",
            "type": "array"
          }
        },
        "required": [
          "default_profile",
          "profiles"
        ],
        "title": "ProfileList",
        "type": "object"
      },
      "RuleKind": {
        "enum": [
          "critical",
          "evidence",
          "blocking",
          "score"
        ],
        "title": "RuleKind",
        "type": "string"
      },
      "RuleSummary": {
        "additionalProperties": false,
        "properties": {
          "effect": {
            "$ref": "#/components/schemas/Decision"
          },
          "kind": {
            "$ref": "#/components/schemas/RuleKind"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "kind",
          "effect",
          "reason"
        ],
        "title": "RuleSummary",
        "type": "object"
      },
      "RunEntry": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "created_at_utc": {
            "format": "date-time",
            "title": "Created At Utc",
            "type": "string"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "mqs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mqs"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "candidate_id",
          "profile",
          "decision",
          "mqs",
          "created_at_utc"
        ],
        "title": "RunEntry",
        "type": "object"
      },
      "RunList": {
        "additionalProperties": false,
        "properties": {
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunEntry"
            },
            "title": "Runs",
            "type": "array"
          }
        },
        "required": [
          "runs"
        ],
        "title": "RunList",
        "type": "object"
      },
      "ScenarioInfo": {
        "additionalProperties": false,
        "description": "Declares whether a run uses simulated inputs, so reports can say so.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "mode": {
            "$ref": "#/components/schemas/ScenarioMode",
            "default": "real"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "simulated_inputs": {
            "items": {
              "type": "string"
            },
            "title": "Simulated Inputs",
            "type": "array"
          }
        },
        "title": "ScenarioInfo",
        "type": "object"
      },
      "ScenarioMode": {
        "enum": [
          "real",
          "simulated"
        ],
        "title": "ScenarioMode",
        "type": "string"
      },
      "ScoreCard": {
        "additionalProperties": false,
        "description": "Dimension scores, weights, and the Model Quality Score.",
        "properties": {
          "dimensions": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DimensionScore"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Dimension"
            },
            "title": "Dimensions",
            "type": "object"
          },
          "effective_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "propertyNames": {
                  "$ref": "#/components/schemas/Dimension"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Weights"
          },
          "insufficient_evidence_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Insufficient Evidence Reason"
          },
          "missing_policy": {
            "$ref": "#/components/schemas/MissingPolicy"
          },
          "mqs": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mqs"
          },
          "mqs_lower_bound": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mqs Lower Bound"
          },
          "mqs_sufficient_evidence": {
            "default": true,
            "title": "Mqs Sufficient Evidence",
            "type": "boolean"
          },
          "overall_coverage": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Overall Coverage",
            "type": "number"
          },
          "provisional": {
            "title": "Provisional",
            "type": "boolean"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Dimension"
            },
            "title": "Weights",
            "type": "object"
          }
        },
        "required": [
          "dimensions",
          "weights",
          "overall_coverage",
          "provisional",
          "missing_policy"
        ],
        "title": "ScoreCard",
        "type": "object"
      },
      "TriggeredRule": {
        "additionalProperties": false,
        "properties": {
          "check_ids": {
            "items": {
              "type": "string"
            },
            "title": "Check Ids",
            "type": "array"
          },
          "effect": {
            "$ref": "#/components/schemas/Decision"
          },
          "kind": {
            "$ref": "#/components/schemas/RuleKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "observed": {
            "title": "Observed"
          },
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          },
          "threshold": {
            "title": "Threshold"
          }
        },
        "required": [
          "rule_id",
          "name",
          "kind",
          "effect",
          "reason"
        ],
        "title": "TriggeredRule",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationRequest": {
        "additionalProperties": false,
        "description": "One candidate to validate. Paths are relative to the server's artifact root.",
        "properties": {
          "candidate_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9._-]{1,80}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "eval_data_path": {
            "description": "CSV with the features and the true labels",
            "maxLength": 400,
            "minLength": 1,
            "title": "Eval Data Path",
            "type": "string"
          },
          "metadata_path": {
            "anyOf": [
              {
                "maxLength": 400,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "training metadata (JSON/YAML)",
            "title": "Metadata Path"
          },
          "model_path": {
            "description": "joblib/pickle model file",
            "maxLength": 400,
            "minLength": 1,
            "title": "Model Path",
            "type": "string"
          },
          "positive_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Positive Label"
          },
          "profile": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9_]{1,60}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "validation profile name; the server default if omitted",
            "title": "Profile"
          },
          "sensitive_columns": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sensitive Columns"
          },
          "target_column": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Column"
          },
          "train_row_hashes_path": {
            "anyOf": [
              {
                "maxLength": 400,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "one SHA-256 row hash per training row",
            "title": "Train Row Hashes Path"
          }
        },
        "required": [
          "model_path",
          "eval_data_path"
        ],
        "title": "ValidationRequest",
        "type": "object"
      },
      "ValidationResult": {
        "additionalProperties": false,
        "description": "The complete, auditable output of one validation run.",
        "properties": {
          "candidate": {
            "$ref": "#/components/schemas/CandidateSummary"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "config_hash": {
            "title": "Config Hash",
            "type": "string"
          },
          "config_snapshot": {
            "additionalProperties": true,
            "title": "Config Snapshot",
            "type": "object"
          },
          "created_at_utc": {
            "format": "date-time",
            "title": "Created At Utc",
            "type": "string"
          },
          "decision": {
            "$ref": "#/components/schemas/DecisionRecord"
          },
          "environment": {
            "additionalProperties": true,
            "title": "Environment",
            "type": "object"
          },
          "explanations": {
            "items": {
              "type": "string"
            },
            "title": "Explanations",
            "type": "array"
          },
          "gate_version": {
            "title": "Gate Version",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenario": {
            "$ref": "#/components/schemas/ScenarioInfo"
          },
          "schema_version": {
            "default": "0.1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "scorecard": {
            "$ref": "#/components/schemas/ScoreCard"
          }
        },
        "required": [
          "gate_version",
          "run_id",
          "created_at_utc",
          "candidate",
          "scenario",
          "config_hash",
          "config_snapshot",
          "checks",
          "scorecard",
          "decision"
        ],
        "title": "ValidationResult",
        "type": "object"
      },
      "ValidationSummary": {
        "additionalProperties": false,
        "description": "The answer to a validation: the recommendation, its score and why.",
        "properties": {
          "action_mode": {
            "$ref": "#/components/schemas/ActionMode",
            "default": "RECOMMENDATION"
          },
          "candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "check_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Check Counts",
            "type": "object"
          },
          "created_at_utc": {
            "format": "date-time",
            "title": "Created At Utc",
            "type": "string"
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "dimension_scores": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Dimension Scores",
            "type": "object"
          },
          "mqs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Model Quality Score 0-100; null if it could not be computed",
            "title": "Mqs"
          },
          "mqs_lower_bound": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "the MQS if every missing check had scored 0",
            "title": "Mqs Lower Bound"
          },
          "mqs_sufficient_evidence": {
            "description": "false: quote the MQS as n/a",
            "title": "Mqs Sufficient Evidence",
            "type": "boolean"
          },
          "notice": {
            "default": "This is a recommendation only. Nothing was deployed, promoted or rolled back.",
            "title": "Notice",
            "type": "string"
          },
          "overall_coverage": {
            "title": "Overall Coverage",
            "type": "number"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "provisional": {
            "title": "Provisional",
            "type": "boolean"
          },
          "report_url": {
            "title": "Report Url",
            "type": "string"
          },
          "result_url": {
            "title": "Result Url",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "triggered_rules": {
            "items": {
              "$ref": "#/components/schemas/RuleSummary"
            },
            "title": "Triggered Rules",
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "candidate_id",
          "profile",
          "decision",
          "summary",
          "mqs",
          "mqs_lower_bound",
          "mqs_sufficient_evidence",
          "overall_coverage",
          "provisional",
          "dimension_scores",
          "triggered_rules",
          "check_counts",
          "created_at_utc",
          "result_url",
          "report_url"
        ],
        "title": "ValidationSummary",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "the key the server was started with (MQVG_API_KEY)",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Validates a trained model and answers with a PROMOTE / HOLD / ROLLBACK **recommendation**. Nothing is deployed, promoted or rolled back. Loading a model runs the code inside its file: read the security notes in docs/api.md before exposing this API.",
    "title": "C3 Model Quality & Validation Gate",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "service"
        ]
      }
    },
    "/v1/checks": {
      "get": {
        "operationId": "list_checks_v1_checks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CheckInfo"
                  },
                  "title": "Response List Checks V1 Checks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Checks",
        "tags": [
          "configuration"
        ]
      }
    },
    "/v1/profiles": {
      "get": {
        "operationId": "list_profiles_v1_profiles_get",
