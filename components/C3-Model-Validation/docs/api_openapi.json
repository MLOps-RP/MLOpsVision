            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "description": "the run_id returned by POST /v1/validations",
              "pattern": "^[0-9a-f]{32}$",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Report",
        "tags": [
          "validation"
        ]
      }
    },
    "/v1/validations/{run_id}/summary": {
      "get": {
        "operationId": "get_summary_v1_validations__run_id__summary_get",
        "parameters": [
          {
            "description": "the run_id returned by POST /v1/validations",
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "description": "the run_id returned by POST /v1/validations",
              "pattern": "^[0-9a-f]{32}$",
